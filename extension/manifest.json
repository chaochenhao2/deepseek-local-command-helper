{
  "manifest_version": 3,
  "name": "DeepSeek 本地命令助手",
  "version": "1.0.0",
  "description": "在 chat.deepseek.com 页面注入一个右上角面板，向本地命令服务器发送命令并展示执行结果。",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "http://chat.deepseek.com/*"
      ],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}
